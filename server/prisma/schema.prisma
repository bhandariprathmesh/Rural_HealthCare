model MockHFRFacility {
  id                String   @id @default(uuid())
  hfrId             String   @unique
  facilityName      String
  facilityType      String   // Sub Centre, PHC, CHC, District Hospital, Diagnostic Centre, Telemedicine Node
  subType           String?
  ownership         String   @default("Government/Public")
  state             String
  district          String
  subDistrict       String?
  village           String?
  pincode           String
  address           String
  latitude          Float?
  longitude         Float?
  contactPhone      String
  contactEmail      String
  services          String[] // ["OPD", "IPD", "Emergency", "Maternity", "Immunization", "Laboratory", "Telemedicine"]
  specialties       String[] // ["General Medicine", "Pediatrics", "Obstetrics & Gynecology", "Minor Surgery"]
  hasEmergency      Boolean  @default(false)
  operationalStatus String   @default("ACTIVE") // ACTIVE, TEMPORARILY_CLOSED
  openingHours      String   @default("24x7")
  registryStatus    String   @default("VERIFIED_MOCK")
  isMock            Boolean  @default(true)
  linkedFacilityId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MockHPRProfessional {
  id                  String   @id @default(uuid())
  hprId               String   @unique
  fullName            String
  gender              String
  professionalType    String   // Doctor, Specialist, Medical Officer, AYUSH Practitioner
  qualification       String   // MBBS, MD, MS, DCH, DNB
  specialties         String[] // ["General Medicine", "Pediatrics", "Obstetrics & Gynecology", "Emergency Medicine"]
  registrationNumber  String   // Council registration number
  registrationCouncil String   // e.g. "Maharashtra Medical Council"
  state               String
  district            String
  primaryHfrId        String?  // Associated facility HFR ID
  primaryFacilityName String?
  languages           String[] // ["Marathi", "Hindi", "English"]
  contactPhone        String
  contactEmail        String
  verificationStatus  String   @default("VERIFIED_MOCK")
  isMock              Boolean  @default(true)
  linkedDoctorId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MockWorkerDirectory {
  id                 String   @id @default(uuid())
  workerCode         String   @unique
  name               String
  workerType         String   @default("ASHA") // ASHA, ANM, CHO
  assignedVillage    String
  subCentre          String
  parentPhcName      String
  parentPhcHfrId     String
  district           String
  state              String
  pincode            String
  contactPhone       String
  languages          String[] // ["Marathi", "Hindi"]
  assignedPopulation Int      @default(1200)
  active             Boolean  @default(true)
  latitude           Float?
  longitude          Float?
  linkedWorkerId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MockABHAProfile {
  id              String   @id @default(uuid())
  abhaAddress     String   @unique // e.g. "mock-abha-000001@sbx"
  abhaNumber      String   @unique // e.g. "91-8472-9102-4411"
  fullName        String
  fullNameHi      String?
  gender          String   // M, F, O
  dob             String   // YYYY-MM-DD
  dayOfBirth      String?
  monthOfBirth    String?
  yearOfBirth     String?
  mobile          String
  address         String
  village         String
  district        String
  state           String
  pincode         String
  authMethods     String[] // ["MOBILE_OTP", "DEMO_AUTH"]
  status          String   @default("ACTIVE")
  isMock          Boolean  @default(true)
  linkedPatientId String?
  linkedHealthId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

